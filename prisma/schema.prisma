// The client is generated into lib/generated/prisma (git-ignored) by
// `prisma generate`, which postinstall and `npm run build` run. Imports carry a
// .ts extension so scripts/*.ts can load it with Node's type stripping.
generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  importFileExtension = "ts"
}

// The connection URL is in prisma.config.ts (CLI) and lib/prisma.ts (app).
datasource db {
  provider = "postgresql"
}

// Ownership (docs/plans/workspace-isolation.md):
// - Global: User and Better Auth's tables, Workspace, WorkspaceMembership.
// - Workspace-owned: every other table carries a non-null workspaceId. Rows
//   that refer to each other use composite (workspaceId, id) foreign keys, so a
//   record, its labels, comments and taxonomy always share one workspace, and
//   row-level security (prisma/migrations, lib/workspace/db.ts) limits each
//   transaction to the workspace it was opened for.

// Global role. Platform admins manage workspaces and accounts and may enter
// every workspace as its admin.
enum PlatformRole {
  admin
  user
}

// Role inside one workspace.
enum WorkspaceRole {
  admin
  supervisor
  labeller
}

enum WorkspaceStatus {
  active
  archived
}

enum MembershipStatus {
  active
  suspended
}

enum SentenceStatus {
  pending
  submitted
  skipped
  escalated
}

enum AnnotationSource {
  user
  ai
}

// User, Session, Account, Verification and RateLimit follow Better Auth's
// schema (lib/auth.ts): core fields plus the username and admin plugins (whose
// `role` is the platform role). Passwords live on the "credential" Account row.
model User {
  id                   String       @id @default(cuid())
  username             String       @unique // Lower case; what people sign in with
  displayUsername      String?
  email                String       @unique // Lower case
  emailVerified        Boolean      @default(false)
  name                 String
  image                String?
  role                 PlatformRole @default(user)
  banned               Boolean?     @default(false)
  banReason            String?
  banExpires           DateTime?
  mustResetPassword    Boolean      @default(true) // Force password reset on first login
  lastLogin            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  // Who created the account (null: setup scripts). Not shown across workspaces.
  createdById          String?
  // Created with an invitation link: no password until the person sets one.
  invitedAt            DateTime?
  invitationAcceptedAt DateTime?

  sessions        Session[]
  accounts        Account[]
  memberships     WorkspaceMembership[]
  annotations     SentenceAnnotation[]
  comments        Comment[]
  auditLogs       AuditLog[]
  imports         SentenceImport[]
  editedSentences Sentence[]            @relation("LastEditor")
  aiLabelingJobs  AILabelingJob[]
  aiLearningJobs  AILearningJob[]       @relation("LearningJobsUser")
  aiSyncJobs      AITaxonomySyncJob[]
  workspaces      Workspace[]           @relation("WorkspaceCreator")
  createdBy       User?                 @relation("AccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAccounts User[]                @relation("AccountCreator")
  addedMembers    WorkspaceMembership[] @relation("MembershipAdder")
  outgoingMails   OutgoingMail[]        @relation("MailRecipient")
  requestedMails  OutgoingMail[]        @relation("MailRequester")
}

// One row per signed-in browser. Signing a user out everywhere deletes their rows.
model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// providerId "credential" holds the password hash (lib/passwords.ts).
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Sign-in rate limits, shared by every app instance.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// An independently managed classification exercise: its own records,
// taxonomies, members, roles and AI learning.
model Workspace {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      WorkspaceStatus @default(active)
  archivedAt  DateTime?
  // Whether new AI jobs may start (lib/ai-connections.ts); needs a connection.
  aiEnabled   Boolean         @default(false)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy      User?                 @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships    WorkspaceMembership[]
  taxonomies     Taxonomy[]
  imports        SentenceImport[]
  sentences      Sentence[]
  aiLabelingJobs AILabelingJob[]
  aiLearningJobs AILearningJob[]
  aiSyncJobs     AITaxonomySyncJob[]
  aiConnections  AIConnectionVersion[]
  auditLogs      AuditLog[]
  invitations    WorkspaceInvitation[]
  memberImports  MemberImport[]
  outgoingMails  OutgoingMail[]
}

// A person's role in one workspace. The supervisor tree links memberships of
// the same workspace (composite key), so one person can be an admin here and a
// labeller elsewhere, with different supervisors.
model WorkspaceMembership {
  id                     String           @id @default(cuid())
  workspaceId            String
  userId                 String
  role                   WorkspaceRole
  status                 MembershipStatus @default(active)
  supervisorMembershipId String?
  lastSeenAt             DateTime?
  // Who added the person to this workspace (an admin, or the invitation's sender).
  addedById              String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id])
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy     User?                 @relation("MembershipAdder", fields: [addedById], references: [id], onDelete: SetNull)
  supervisor  WorkspaceMembership?  @relation("MembershipTree", fields: [workspaceId, supervisorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  reports     WorkspaceMembership[] @relation("MembershipTree")
  assignments SentenceAssignment[]

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId])
  @@index([workspaceId, supervisorMembershipId])
}

model Taxonomy {
  id                              String    @id @default(cuid())
  workspaceId                     String
  key                             String // Unique within its workspace
  description                     String?
  levelNames                      Json? // { "1": "Major Group", "2": "Sub-major", ... }
  maxDepth                        Int       @default(5)
  isActive                        Boolean   @default(true)
  createdById                     String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  lastLearningAt                  DateTime?
  lastLearningJobId               String?
  lastLearningStatus              String?
  lastLearningError               String?
  newAnnotationsSinceLastLearning Int       @default(0)

  workspace      Workspace              @relation(fields: [workspaceId], references: [id])
  nodes          TaxonomyNode[]
  synonyms       TaxonomySynonym[]
  annotations    SentenceAnnotation[]
  settings       TaxonomySetting?
  aiSuggestions  SentenceAISuggestion[]
  aiLabelingJobs AILabelingJob[]
  aiLearningJobs AILearningJob[]        @relation("LearningJobs")
  aiSyncJobs     AITaxonomySyncJob[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, id])
}

model TaxonomySetting {
  id                  String   @id @default(cuid())
  workspaceId         String
  taxonomyId          String   @unique
  autoSelectThreshold Float?
  taxonomy            Taxonomy @relation(fields: [workspaceId, taxonomyId], references: [workspaceId, id])

  @@unique([workspaceId, taxonomyId])
}

model TaxonomyNode {
  code        String
  id          String  @id @default(cuid())
  workspaceId String
  taxonomyId  String
  label       String
  definition  String?
  examples    String?
  parentCode  String?
  level       Int
  path        String?
  isLeaf      Boolean

  taxonomy Taxonomy          @relation(fields: [workspaceId, taxonomyId], references: [workspaceId, id])
  synonyms TaxonomySynonym[]

  @@unique([taxonomyId, code])
  @@unique([taxonomyId, id])
  @@index([taxonomyId, level])
  @@index([taxonomyId, parentCode])
}

model TaxonomySynonym {
  id          String @id @default(cuid())
  workspaceId String
  taxonomyId  String
  nodeId      String
  synonym     String

  taxonomy Taxonomy     @relation(fields: [workspaceId, taxonomyId], references: [workspaceId, id])
  // The node must belong to the same taxonomy, not just the same workspace.
  node     TaxonomyNode @relation(fields: [taxonomyId, nodeId], references: [taxonomyId, id])

  @@index([taxonomyId, nodeId])
}

model SentenceImport {
  id           String   @id @default(cuid())
  workspaceId  String
  fileName     String
  uploadedAt   DateTime @default(now())
  uploadedById String?
  totalRows    Int

  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  uploadedBy User?      @relation(fields: [uploadedById], references: [id])
  sentences  Sentence[]

  @@unique([workspaceId, id])
  @@index([workspaceId, uploadedAt])
}

model SentenceAssignment {
  id           String   @id @default(cuid())
  workspaceId  String
  sentenceId   String
  membershipId String
  assignedAt   DateTime @default(now())
  assignedBy   String?

  sentence   Sentence            @relation(fields: [workspaceId, sentenceId], references: [workspaceId, id], onDelete: Cascade)
  membership WorkspaceMembership @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([sentenceId, membershipId])
  @@index([membershipId])
  @@index([sentenceId])
}

model Sentence {
  id          String @id @default(cuid()) // Internal; URLs, joins and AI use it
  workspaceId String
  recordKey   String // The CSV's `id` (or a generated one); unique within the workspace
  importId    String
  importOrder Int // Order within the import file (row number)

  // Field columns (what gets labeled) - max 5
  field1 String // Required: first field_ column from CSV
  field2 String?
  field3 String?
  field4 String?
  field5 String?

  // Support columns (context/metadata) - max 5
  support1 String?
  support2 String?
  support3 String?
  support4 String?
  support5 String?

  // Field name mappings for UI display
  fieldMapping   Json // { "1": "job_title", "2": "job_description", ... }
  supportMapping Json? // { "1": "years_experience", "2": "industry", ... }

  flagged      Boolean        @default(false)
  status       SentenceStatus @default(pending)
  lastEditorId String?
  lastEditedAt DateTime?
  createdAt    DateTime       @default(now())

  workspace     Workspace              @relation(fields: [workspaceId], references: [id])
  import        SentenceImport         @relation(fields: [workspaceId, importId], references: [workspaceId, id], onDelete: Cascade)
  lastEditor    User?                  @relation("LastEditor", fields: [lastEditorId], references: [id])
  annotations   SentenceAnnotation[]
  comments      Comment[]
  assignments   SentenceAssignment[]
  aiSuggestions SentenceAISuggestion[]
  labelingJobs  AILabelingJobInput[]
  learningJobs  AILearningJobInput[]

  @@unique([workspaceId, recordKey])
  @@unique([workspaceId, id])
  @@index([importId])
  @@index([workspaceId, status])
  @@index([workspaceId, field1])
  @@index([importId, importOrder])
}

model SentenceAnnotation {
  id                String           @id @default(cuid())
  workspaceId       String
  sentenceId        String
  taxonomyId        String
  level             Int
  nodeCode          String // Level-specific unknown codes: lib/constants.ts
  source            AnnotationSource
  createdById       String?
  labelingStartedAt DateTime? // When labeling session started
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  sentence  Sentence @relation(fields: [workspaceId, sentenceId], references: [workspaceId, id])
  taxonomy  Taxonomy @relation(fields: [workspaceId, taxonomyId], references: [workspaceId, id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@unique([sentenceId, taxonomyId, level])
  @@index([nodeCode])
  @@index([createdById, createdAt])
  @@index([workspaceId, createdAt])
}

model SentenceAISuggestion {
  id              String   @id @default(cuid())
  workspaceId     String
  sentenceId      String
  taxonomyId      String
  level           Int
  nodeCode        String
  confidenceScore Float
  suggestedAt     DateTime @default(now())

  sentence Sentence @relation(fields: [workspaceId, sentenceId], references: [workspaceId, id], onDelete: Cascade)
  taxonomy Taxonomy @relation(fields: [workspaceId, taxonomyId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([sentenceId, taxonomyId, level])
  @@index([sentenceId])
  @@index([taxonomyId, nodeCode])
  @@index([confidenceScore])
  @@index([suggestedAt])
}

enum AILabelingJobStatus {
  pending
  processing
  completed
  failed
  cancelled
}

model AILabelingJob {
  id                  String              @id @default(cuid())
  workspaceId         String
  createdById         String
  taxonomyId          String
  status              AILabelingJobStatus @default(pending)
  totalSentences      Int
  processedSentences  Int                 @default(0)
  failedSentences     Int                 @default(0)
  batchSize           Int                 @default(1000)
  // How the records were chosen (for display); the records themselves are
  // the job's AILabelingJobInput rows.
  filterCriteria      Json?
  connectionVersionId String
  externalJobId       String?
  startedAt           DateTime            @default(now())
  completedAt         DateTime?
  errorMessage        String?
  // Which app instance monitors the job, until when (lib/ai-job-monitor.ts).
  leaseOwner          String?
  leaseExpiresAt      DateTime?

  workspace  Workspace            @relation(fields: [workspaceId], references: [id])
  createdBy  User                 @relation(fields: [createdById], references: [id])
  taxonomy   Taxonomy             @relation(fields: [workspaceId, taxonomyId], references: [workspaceId, id])
  connection AIConnectionVersion  @relation(fields: [workspaceId, connectionVersionId], references: [workspaceId, id])
  inputs     AILabelingJobInput[]

  @@unique([workspaceId, id])
  @@index([status])
  @@index([createdById])
  @@index([taxonomyId])
  @@index([workspaceId, startedAt])
}

model AILearningJob {
  id                  String              @id @default(cuid())
  workspaceId         String
  createdById         String
  taxonomyId          String
  status              AILabelingJobStatus @default(pending)
  totalSentences      Int
  processedSentences  Int                 @default(0)
  failedSentences     Int                 @default(0)
  batchSize           Int                 @default(100)
  filterCriteria      Json?
  connectionVersionId String
  externalJobId       String?
  startedAt           DateTime            @default(now())
  completedAt         DateTime?
  errorMessage        String?
  // Which app instance monitors the job, until when (lib/ai-job-monitor.ts).
  leaseOwner          String?
  leaseExpiresAt      DateTime?

  workspace  Workspace            @relation(fields: [workspaceId], references: [id])
  createdBy  User                 @relation("LearningJobsUser", fields: [createdById], references: [id])
  taxonomy   Taxonomy             @relation("LearningJobs", fields: [workspaceId, taxonomyId], references: [workspaceId, id])
  connection AIConnectionVersion  @relation(fields: [workspaceId, connectionVersionId], references: [workspaceId, id])
  inputs     AILearningJobInput[]

  @@unique([workspaceId, id])
  @@index([status])
  @@index([createdById])
  @@index([taxonomyId])
  @@index([workspaceId, startedAt])
}

// The records of one labeling job, in the order they are sent: the
// authoritative input set (results for other records are rejected).
model AILabelingJobInput {
  workspaceId String
  jobId       String
  sentenceId  String
  position    Int

  job      AILabelingJob @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Cascade)
  sentence Sentence      @relation(fields: [workspaceId, sentenceId], references: [workspaceId, id], onDelete: Cascade)

  @@id([jobId, sentenceId])
  @@index([sentenceId])
}

// The records whose human labels one learning job sends.
model AILearningJobInput {
  workspaceId String
  jobId       String
  sentenceId  String
  position    Int

  job      AILearningJob @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Cascade)
  sentence Sentence      @relation(fields: [workspaceId, sentenceId], references: [workspaceId, id], onDelete: Cascade)

  @@id([jobId, sentenceId])
  @@index([sentenceId])
}

// Sending a taxonomy to the AI service (POST /taxonomies), with the same
// lease and recovery discipline as labeling and learning jobs.
model AITaxonomySyncJob {
  id                  String              @id @default(cuid())
  workspaceId         String
  taxonomyId          String
  connectionVersionId String
  createdById         String?
  status              AILabelingJobStatus @default(pending)
  externalJobId       String?
  startedAt           DateTime            @default(now())
  completedAt         DateTime?
  errorMessage        String?
  leaseOwner          String?
  leaseExpiresAt      DateTime?

  workspace  Workspace           @relation(fields: [workspaceId], references: [id])
  taxonomy   Taxonomy            @relation(fields: [workspaceId, taxonomyId], references: [workspaceId, id], onDelete: Cascade)
  connection AIConnectionVersion @relation(fields: [workspaceId, connectionVersionId], references: [workspaceId, id])
  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([status])
  @@index([taxonomyId, startedAt])
  @@index([workspaceId, startedAt])
}

// An AI service endpoint a platform admin approved (control plane). Workspace
// connections can only point at approved, unretired endpoints, so workspace
// settings cannot become arbitrary server-side network access. The URL never
// changes; retire it and approve a new one instead.
model AIEndpoint {
  id          String    @id @default(cuid())
  name        String
  baseUrl     String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  retiredAt   DateTime?

  connections AIConnectionVersion[]
}

// One immutable version of a workspace's AI connection: an approved endpoint,
// the namespace and an encrypted credential (lib/ai-credentials.ts). A new
// version retires the previous one; jobs keep the version they started with,
// so a settings change never redirects a running job. A retired version's
// credential is erased once no active job uses it.
model AIConnectionVersion {
  id          String    @id @default(cuid())
  workspaceId String
  version     Int
  endpointId  String
  namespace   String
  credential  String? // Ciphertext with its key id; never returned by any API
  createdById String?
  createdAt   DateTime  @default(now())
  retiredAt   DateTime?

  workspace    Workspace           @relation(fields: [workspaceId], references: [id])
  endpoint     AIEndpoint          @relation(fields: [endpointId], references: [id])
  labelingJobs AILabelingJob[]
  learningJobs AILearningJob[]
  syncJobs     AITaxonomySyncJob[]

  @@unique([workspaceId, version])
  @@unique([workspaceId, id])
}

model Comment {
  id          String    @id @default(cuid())
  workspaceId String
  sentenceId  String
  authorId    String
  body        String
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  sentence Sentence @relation(fields: [workspaceId, sentenceId], references: [workspaceId, id])
  author   User     @relation(fields: [authorId], references: [id])

  @@index([sentenceId])
}

// Who did what to which object (lib/audit.ts). workspaceId is null for
// platform events (accounts, workspaces). actorName keeps the username when
// the actor is later deleted (actorId is then set to null).
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  actorName   String?
  action      String
  entityType  String
  entityId    String
  payload     Json?
  /// The request that caused the event (x-request-id, lib/request-id.ts), to find its log lines.
  requestId   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  actor     User?      @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
}

// Outgoing email (lib/mail). Metadata only: never the body, a link, a token
// or a password. Global (no row security), like accounts; workspaceId names
// the workspace a mail was sent from, if any.
enum MailPurpose {
  invitation // New account: link to choose a password
  workspace_invitation // Invitation to join a workspace (any address)
  password_link // Forgotten password, or sent by an admin
  password_changed
  email_changed // Notice to the old address
  credentials // Generated temporary password; never retried
}

// sent: the transport accepted it; failed: definite refusal (resending is
// safe); unknown: timeout, network or server error, or the server stopped
// while sending (it may have gone out). Never resent automatically.
enum MailStatus {
  pending
  sending
  sent
  failed
  unknown
}

model OutgoingMail {
  id            String      @id @default(cuid())
  purpose       MailPurpose
  status        MailStatus  @default(pending)
  userId        String?
  workspaceId   String?
  invitationId  String?
  // Only for notices to an address the account no longer has (email_changed).
  recipient     String?
  requestedById String?
  attempts      Int         @default(0)
  detail        String? // Safe text only
  createdAt     DateTime    @default(now())
  claimedAt     DateTime?
  sentAt        DateTime?

  user        User?                @relation("MailRecipient", fields: [userId], references: [id], onDelete: SetNull)
  requestedBy User?                @relation("MailRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id])
  invitation  WorkspaceInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([invitationId])
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

// An invitation to join a workspace, sent to an email address whether or not
// an account has it (so inviting reveals nothing). Accepting needs the
// signed-in account with that address. Control plane like memberships: the
// invitee has no workspace context until they accept.
model WorkspaceInvitation {
  id                     String           @id @default(cuid())
  workspaceId            String
  email                  String // Lower case
  role                   WorkspaceRole
  supervisorMembershipId String?
  invitedById            String?
  // SHA-256 of the secret part of the current link; a resend replaces it.
  tokenHash              String?
  expiresAt              DateTime
  status                 InvitationStatus @default(pending)
  acceptedById           String?
  acceptedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  mails     OutgoingMail[]

  @@unique([workspaceId, id])
  @@index([workspaceId, email])
}

// A committed CSV member import (U4): the key the browser sent with the
// commit, so a replayed or concurrent commit returns this outcome instead of
// creating or mailing again. Rows hold no passwords.
model MemberImport {
  id          String   @id @default(cuid())
  workspaceId String
  importKey   String
  fileName    String
  createdById String?
  rowCount    Int
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id])
  rows      MemberImportRow[]

  @@unique([workspaceId, importKey])
  @@unique([workspaceId, id])
}

model MemberImportRow {
  id          String  @id @default(cuid())
  workspaceId String
  importId    String
  line        Int
  username    String
  userId      String?
  access      String
  mailId      String?

  import MemberImport @relation(fields: [workspaceId, importId], references: [workspaceId, id], onDelete: Cascade)

  @@index([importId])
}
