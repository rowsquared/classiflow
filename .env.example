# Starting point for local Docker Compose (`docker compose up`) and `npm run dev`.
# Every variable is explained in ENV_SETUP.md. Replace each "set-me" value.

# --- Database -----------------------------------------------------------------
# Used by `npm run dev` and Prisma on the host (dev database from
# docker-compose.dev.yml). docker-compose.yml builds its own DATABASE_URL.
DATABASE_URL="postgresql://classiflow:classiflow_password@localhost:5434/classiflow?schema=public"

# docker-compose.yml only. POSTGRES_PASSWORD is required (Compose refuses to start without it).
POSTGRES_USER="classiflow"
POSTGRES_PASSWORD="set-me-to-a-long-random-password"
POSTGRES_DB="classiflow"
# Required with docker-compose.yml: the server's least-privilege role, bound by
# workspace row security (DEPLOYMENT.md "Database roles"). At least 16 characters.
APP_DB_USER="classiflow_app"
APP_DB_PASSWORD="set-me-to-another-long-random-password"

# --- Authentication (Better Auth) ---------------------------------------------------
# Public URL of the app. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="set-me-with-openssl-rand-base64-32"

# --- First admin (created only while the database has no admin) ----------------
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_NAME="Admin User"
# At least 8 characters; must be changed at first sign-in. Placeholders such as
# "ChangeMe123!" are refused when NODE_ENV=production (as in Docker Compose).
DEFAULT_ADMIN_PASSWORD=""

# --- AI suggestions (optional) ----------------------------------------------------
# Leave these commented out for human-only labelling.
# AI_LABELING_API_URL="https://taxomind.example.com"
# AI_LABELING_API_KEY="set-me"
# AI_SOURCE_SLUG=""
# AI_LABELING_BATCH_SIZE=100
# AI_LEARNING_BATCH_SIZE=100
# AI_LEARNING_MIN_NEW_ANNOTATIONS=500
# AI_JOB_POLL_INTERVAL_MS=5000
# AI_JOB_POLL_TIMEOUT_MS=600000

# --- Logs and traces (optional) ---------------------------------------------------
# LOG_LEVEL="info"
# Tracing stays off unless an OTLP/HTTP collector is set.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4318"
# OTEL_EXPORTER_OTLP_HEADERS=""
# OTEL_SERVICE_NAME="classiflow"
