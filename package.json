{
  "scripts": {
    "dev": "next dev",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:init-admin": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/init-admin.ts",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "taxomind:types": "openapi-typescript lib/contracts/taxomind.openapi.json -o lib/contracts/taxomind.openapi.ts"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "^5.90.5",
    "better-auth": "1.7.12",
    "csv-parse": "7.0.3",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "unrs-resolver": true
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
